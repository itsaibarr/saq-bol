#!/bin/sh
# Kaggle CLI pinned to one account's token (stored outside the repo in ~/.kaggle-itsaibarr), isolated HOME.
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
KH="${TMPDIR:-/tmp}/kgl_home"; mkdir -p "$KH"
exec env KAGGLE_API_TOKEN="$(cat "$HOME/.kaggle-itsaibarr/access_token")" HOME="$KH" "$ROOT/.venv/bin/kaggle" "$@"
